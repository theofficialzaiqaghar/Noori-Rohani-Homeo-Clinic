{
  "name": "noori-roohani-homeo-clinic",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/patch-clinic-i18n.mjs && node scripts/sync-public.mjs",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "prebuild": "node scripts/patch-clinic-i18n.mjs && node scripts/sync-public.mjs",
    "build": "vite build && node scripts/copy-static.mjs",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "qa:i18n": "node scripts/qa-i18n.mjs",
    "qa": "node scripts/qa-i18n.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "framer-motion": "^12.6.3",
    "gsap": "^3.13.0",
    "lenis": "^1.3.3",
    "multer": "^1.4.5-lts.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^6.3.5"
  }
}
